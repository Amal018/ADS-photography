# Public site URL, used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.adsphotography.in

# Optional: sends every enquiry to the studio WhatsApp number (site.whatsapp)
# through CallMeBot. Get a key by messaging CallMeBot from that phone:
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=

# Optional: every validated contact enquiry is also POSTed here as JSON
# (e.g. a Zapier/Make webhook, Google Apps Script, or your own API).
CONTACT_WEBHOOK_URL=
